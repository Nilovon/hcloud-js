{
  "name": "@nilovonjs/hcloud-js",
  "version": "2.0.0",
  "description": "Modern TypeScript SDK for the Hetzner Cloud API - fully typed, validated, with auto-pagination, action waiting, retries and typed errors",
  "author": "Nilovon",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "hetzner",
    "hetzner-cloud",
    "hcloud",
    "cloud",
    "api",
    "sdk",
    "typescript",
    "zod",
    "servers",
    "networks",
    "load-balancer",
    "dns",
    "storage-box",
    "infrastructure"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nilovon/hcloud-js.git",
    "directory": "packages/library"
  },
  "bugs": {
    "url": "https://github.com/Nilovon/hcloud-js/issues"
  },
  "homepage": "https://hcloud-js.nilovon.com",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test",
    "check-types": "tsc --noEmit",
    "lint:package": "publint --strict && attw --pack . --profile node16",
    "prepublishOnly": "bun run check-types && bun test && bun run build && bun run lint:package",
    "prepack": "cp ../../CHANGELOG.md CHANGELOG.md"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hcloud-js/config": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.4.4",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
