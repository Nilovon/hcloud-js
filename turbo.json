{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "test": {
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json"
      ]
    },
    "check-types": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
