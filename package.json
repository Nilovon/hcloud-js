{
  "name": "hcloud-js",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:docs": "turbo -F @hcloud-js/docs dev",
    "build": "turbo build",
    "build:library": "turbo -F @nilovonjs/hcloud-js build",
    "test": "turbo test",
    "check-types": "turbo check-types",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "oxlint && oxfmt --write",
    "ci": "oxlint && oxfmt --check && turbo check-types test build",
    "publish:library": "cd packages/library && bun publish",
    "publish:library:dry-run": "cd packages/library && bun pm pack --dry-run"
  },
  "devDependencies": {
    "@hcloud-js/config": "workspace:*",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
